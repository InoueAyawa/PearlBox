    "/api/v1/workshop/import": {
      "post": {
        "summary": "Import a local descriptor. Import does not enable mining or remote control.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "pearlboxPlugin",
                      "type",
                      "id"
                    ],
                    "properties": {
                      "pearlboxPlugin": {
                        "const": 1
                      },
                      "type": {
                        "const": "builtin"
                      },
                      "id": {
                        "enum": [
                          "control-master",
                          "control-agent",
                          "cpu-xmr"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "pearlboxPlugin",
                      "type",
                      "id",
                      "name",
                      "version",
                      "metrics"
                    ],
                    "properties": {
                      "pearlboxPlugin": {
                        "const": 1
                      },
                      "type": {
                        "const": "monitor"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^local-[a-z0-9][a-z0-9-]{0,40}$"
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 60
                      },
                      "version": {
                        "type": "string"
                      },
                      "metrics": {
                        "type": "array",
                        "maxItems": 5,
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "hashrate",
                            "shares",
                            "power",
                            "temperature",
                            "uptime"
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON result"
          },
          "400": {
            "description": "Invalid input or state"
          },
          "401": {
            "description": "Missing local bearer"
          },
          "403": {
            "description": "Invalid browser session or origin"
          }
        }
      }
    },
